{
  "name": "bridge-maker-build-and-cross",
  "version": "1.0.0",
  "private": true,
  "description": "BRIDGE MAKER: BUILD & CROSS - a procedural, asset-free HTML5 bridge construction physics puzzle game.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:youtube": "tsc --noEmit && vite build --mode youtube",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts",
    "check:assets": "tsx scripts/check-assets.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:assets",
    "qa": "python3 qa/browser_qa.py",
    "solve-check": "tsx scripts/solve-check.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
